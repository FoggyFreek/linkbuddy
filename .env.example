# Copy to .env for local development (server/index.js loads it via dotenv).
# In production inject these through your secret manager instead.

# HTTP port of the linkpage API/server.
LINKPAGE_PORT=3010

# Postgres connection. Either a full URL — which wins over everything below, and
# whose password must be percent-encoded if it contains @ : / # or % ...
#LINKPAGE_DATABASE_URL=postgres://user:pass@localhost:5432/gigbuddy_linkpage
# ...or the standard PG* variables, read by the pg driver itself (no code here
# names them). Omit them entirely against a native local Postgres with OS-user
# auth; set them when the database needs real credentials, e.g. one running in
# Docker with 5432 published:
#PGHOST=localhost
#PGPORT=5432
#PGUSER=linkpage
#PGPASSWORD=
# The database name always comes from here, never from a stray PGDATABASE:
# statistics and page layouts live in this dedicated database, NEVER gigbuddy's.
LINKPAGE_PGDATABASE=gigbuddy_linkpage

# Optional pool size (default 10).
#LINKPAGE_PG_POOL_MAX=10

# --- Docker Compose (docker-compose.yml) ---
# The compose stack runs its own Postgres and points the app at it via PG* vars
# automatically (overriding anything above), so you only need the credentials
# here. POSTGRES_PASSWORD is required; user/db default to linkpage /
# gigbuddy_linkpage. These three are consumed by the postgres container itself.
POSTGRES_PASSWORD=change-me
#POSTGRES_USER=linkpage
#POSTGRES_DB=gigbuddy_linkpage

# Origin of the GigBuddy API this app syncs content from (server-to-server, so
# an internal address is fine).
GIGBUDDY_URL=http://localhost:3002

# Where visitors reach GigBuddy in a browser — the href behind the public page's
# "powered by gigBuddy" badge. Separate from GIGBUDDY_URL because the API origin
# need not be publicly routable. Unset hides the badge.
GIGBUDDY_WEB_URL=http://localhost:5173

# Shared HMAC secret — must equal LINKPAGE_SECRET in the GigBuddy deployment.
# Used to verify editor handoff tokens, sign editor sessions, and authenticate
# the server-to-server content export pull.
GIGBUDDY_SYNC_SECRET=

# Public origin of this app (used in absolute URLs shown to editors).
LINKPAGE_PUBLIC_URL=http://localhost:5175

# Minutes before a page's synced content snapshot is considered stale and
# refreshed in the background on public views (keeps gig listings current).
LINKPAGE_CONTENT_TTL_MINUTES=15

# Privacy controls for visit statistics (see PRIVACY.md).
# Statistics live in a rolling window: each page keeps its band's plan window
# (30 days, or 90 on gold — synced from GigBuddy) with this value as the
# fallback for pages without plan data. Hard-capped at 90 days.
STATS_RETENTION_DAYS=30
# Set to 1 to disable all visit statistics collection.
STATS_DISABLED=
